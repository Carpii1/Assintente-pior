# Configurações do Assistente Multimodal PIOR
# Crie uma cópia deste arquivo com o nome .env e preencha suas variáveis.

# 1. Ollama Local Host (Padrão: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
# Diretório personalizado de modelos do Ollama (opcional)
# OLLAMA_MODELS=F:\IA\Ollama\Models

# 2. Modelo Principal Multimodal Recomendado
# Opções locais: pior-vl:8b (criado via Modelfile.pior), qwen3-vl:8b-instruct, qwen3:8b
DEFAULT_MODEL=pior-vl:8b

# 3. Servidor Web FastAPI
HOST=0.0.0.0
PORT=8000

# 4. (Opcional) Provedores Externos Cloud / Groq / OpenAI
# GROQ_API_KEY=sua_chave_groq_aqui
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# OPENAI_API_KEY=${GROQ_API_KEY}
